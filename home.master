        <script type="text/javascript">
            $(document).ready(function () {
                $('.drophome').mouseover(function () {

                    var a = $(this).attr('id');
                    $('.submenu').css('display', 'none');
//                    $(this).css('background-color', 'white');
                    $('.' + a).css('display', 'inline');
//                    visibility: hidden;
                    $('.drophome').removeClass("headmenuover");
                    $(this).addClass("headmenuover");
                })
                $('.drophome').mouseout(function () {
                    //                    $(this).next('div.submenu').attr('display', 'none');
                    //                    $(this).next('div.submenu').css('display', 'none');
                    //                    $('.submenu').css('display', 'none');

                })
            });
</script>
   
